{
  "name": "devshelf",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "sync": "tsx scripts/sync-books.ts",
    "sync:check": "tsx scripts/sync-books.ts --check",
    "sync:covers": "tsx scripts/fetch-covers.ts",
    "check:links": "tsx scripts/check-links.ts",
    "generate:feeds": "tsx scripts/generate-feeds.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "smoke": "node scripts/smoke.mjs",
    "check:readme": "node scripts/check-readme.mjs README.md",
    "capture:screenshots": "node scripts/capture-screenshots.mjs",
    "test:parser": "tsx --test scripts/lib/parse-books.test.ts",
    "test:diff": "tsx --test scripts/lib/sync-diff.test.ts",
    "test": "tsx --test scripts/lib/*.test.ts",
    "prepare-assets": "node scripts/copy-pdf-worker.mjs",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs && npm run generate:feeds"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^1.1.7",
    "dompurify": "^3.3.1",
    "fuse.js": "^7.5.0",
    "geist": "^1.9.2",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "pdfjs-dist": "^6.5.438",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.4.0",
    "unified": "^11.0.5",
    "zod": "^4.3.6",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "playwright-core": "^1.65.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  }
}
